# Required by the primary Jev + ChatGPT hybrid profile.
JEV_API_KEY=
# TYPESAFE_API_KEY is accepted as an alternative to JEV_API_KEY.
TYPESAFE_API_KEY=
# Optional direct OpenAI API backend only. ChatGPT subscription execution does
# not need this and deliberately removes it from the Codex child process.
OPENAI_API_KEY=
# .env is not automatically sourced.
# Future integrations (not implemented):
HIGGSFIELD_API_KEY=
